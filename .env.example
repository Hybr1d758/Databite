# S3
S3_BUCKET=your-bucket            # or S3_BUCKET_NAME
RAW_PREFIX=raw
CURATED_PREFIX=curated
AWS_REGION=eu-north-1            # or AWS_DEFAULT_REGION

# AWS credentials (prefer profiles/roles in prod)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Logging
LOG_LEVEL=INFO

# Transform controls
# DATE=YYYYMMDD
# RAW_KEY=s3://your-bucket/raw/openfoodfacts-products-YYYYMMDD.jsonl.gz
# MAX_ROWS=50000

# Postgres (optional for load stage)
# PG_DSN=postgresql://user:pass@host:5432/openfoodfacts
# PG_TABLE=openfoodfacts_products
# PG_BATCH_SIZE=5000

# Optional SSE for uploads
# SSE_ALGO=aws:kms
# SSE_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY_ID
